# Local-only full build: builds the patched Nuked-SC55 and copies ROMs in.
# Never published - the emulator is not public domain and ROMs are Roland's.
build_local_full.bat
NukedSC55/
temp/

# Corpus test tools (run_tests.bat). The sources in tests/ are committed; the
# build output and the baselines are not - baselines are paths and hashes from a
# song library that is not public, and would be thousands of lines.
build_tests/
build_tests_*.log
tests/baseline-*.txt
tests/baseline-*.txt.prev
wav_out/
