diff --git a/src/common/rom_loader.cpp b/src/common/rom_loader.cpp
index d98c260..c5c2f90 100644
--- a/src/common/rom_loader.cpp
+++ b/src/common/rom_loader.cpp
@@ -82,7 +82,41 @@ LoadRomsetError LoadRomset(AllRomsetInfo&               romset_info,
 
         if (!PickCompleteRomset(romset_info, result.romset))
         {
-            return LoadRomsetError::NoCompleteRomsets;
+            // Hash detection only recognises the dumps it has hashes for - the
+            // table carries SC-55 v1.21 alone, so a v1.00/v1.10/v1.20/v2.00 set
+            // finds nothing, and its rom1 can even hash as a DIFFERENT model's
+            // (v2.00's is listed under SC-155). The user just sees the emulator
+            // refuse to start with no useful explanation.
+            //
+            // Those dumps do follow the conventional filenames, so fall back to
+            // detection by name rather than giving up. Only reached when hashes
+            // produced nothing usable, so a recognised set still wins
+            // (2026-07-29).
+            AllRomsetInfo by_name{};
+            DetectRomsetsByFilename(rom_directory, by_name);
+
+            // DetectRomsetsByFilename fills in the conventional path for every
+            // romset WITHOUT checking any of them exist, so RomsetInfo::HasRom
+            // would answer yes for all of them and PickCompleteRomset would
+            // always return the first. Drop what isn't actually on disk before
+            // asking which set is complete.
+            for (size_t rs = 0; rs < ROMSET_COUNT; ++rs)
+            {
+                for (size_t loc = 0; loc < ROMLOCATION_COUNT; ++loc)
+                {
+                    auto& path = by_name.romsets[rs].rom_paths[loc];
+                    if (!path.empty() && !std::filesystem::exists(path))
+                    {
+                        path.clear();
+                    }
+                }
+            }
+
+            if (!PickCompleteRomset(by_name, result.romset))
+            {
+                return LoadRomsetError::NoCompleteRomsets;
+            }
+            romset_info = std::move(by_name);
         }
     }
 
