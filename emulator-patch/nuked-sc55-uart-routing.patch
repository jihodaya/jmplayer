diff --git a/src/standard/serial_win32.cpp b/src/standard/serial_win32.cpp
index a6d1730..5d4f27e 100644
--- a/src/standard/serial_win32.cpp
+++ b/src/standard/serial_win32.cpp
@@ -4,6 +4,7 @@
 #include <mutex>
 #include <string>
 #include <windows.h>
+#include <avrt.h>
 #include <thread>
 
 #define BUFFER_SIZE 4096
@@ -415,16 +416,71 @@ void SERIAL_Quit()
     return;
 }
 
+// Reads the port itself rather than waiting for the event loop to do it.
+//
+// SERIAL_Update() is what issues and completes the overlapped read, and the
+// only caller was FE_EventLoop - which runs on an SDL_Delay(15) tick. So
+// whatever the host sent was picked up in ~15 ms clumps, and a fast passage
+// arrived bunched together instead of spread out: audibly behind the beat,
+// where loopMIDI (a callback, delivered at once) is not. The old loop also spun
+// at full speed holding serial_io_mutex, starving the very update it depended
+// on and burning a core (2026-07-29).
+//
+// Pumping here drops delivery latency to the poll interval below. The event
+// loop still calls SERIAL_Update() for writes; both take the mutex, so running
+// in both places is safe.
 void SERIAL_Read_Updater(FE_Application& fe, serial_read_callback read_callback)
 {
+    // Ask the multimedia scheduler to treat this like an audio thread.
+    //
+    // SDL already registers the audio callback thread with MMCSS - measured, it
+    // runs at priority 24 - but this one is left at the ordinary 9 or 10. It
+    // takes serial_io_mutex on every pass, and the emulation that fills the
+    // audio buffer needs the same lock, so whenever this thread is descheduled
+    // while holding it the sound stops being generated. That is why a very
+    // light program starting up - the Windows card game, in the report of
+    // 2026-08-19 - can put noise in the output while the process as a whole is
+    // using under a quarter of one core: it is not short of CPU, it is losing
+    // the lock at the wrong moment.
+    //
+    // This thread exists only on the named-pipe path, which is why the same
+    // music through loopMIDI has never had the problem.
+    //
+    // "Pro Audio" is the right task here rather than a raw priority bump: the
+    // thread does almost nothing, so it takes essentially nothing away from
+    // whatever else is running, and MMCSS gives back its boost when it idles.
+    DWORD mmcssIndex = 0;
+    HANDLE mmcss = AvSetMmThreadCharacteristicsW(L"Pro Audio", &mmcssIndex);
+    if (mmcss)
+        AvSetMmThreadPriority(mmcss, AVRT_PRIORITY_HIGH);
+
     while (serial_thread_run)
     {
-        std::lock_guard<std::mutex> lock(serial_io_mutex);
+        SERIAL_Update();            // takes the mutex itself - do not hold it here
 
-        if (SERIAL_HasData())
+        bool delivered = false;
+        for (;;)
         {
-            uint8_t sbyte = SERIAL_ReadUART();
-            read_callback(fe, sbyte);        
+            uint8_t sbyte;
+            {
+                std::lock_guard<std::mutex> lock(serial_io_mutex);
+                if (!SERIAL_HasData())
+                    break;
+                sbyte = SERIAL_ReadUART();
+            }
+            // Routed outside the lock: it reaches into the emulator and has no
+            // business holding up the writer.
+            read_callback(fe, sbyte);
+            delivered = true;
         }
+
+        // Only idles when the line is quiet, so a busy passage is never waited
+        // on. 250 us keeps the thread cheap while staying far below the ~320 us
+        // a single MIDI byte occupies on a real 31250-baud cable.
+        if (!delivered)
+            std::this_thread::sleep_for(std::chrono::microseconds(250));
     }
+
+    if (mmcss)
+        AvRevertMmThreadCharacteristics(mmcss);
 }
